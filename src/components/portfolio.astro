---
import Divider from "./Divider.astro";
import Reveal from "./Reveal.astro";

interface PortfolioItem {
  title: string;
  description: string;
  image: string;
  category: string;
  location: string;
}

const items: PortfolioItem[] = [
  {
    title: "Nowoczesna kuchnia",
    description:
      "Luksusowa zabudowa z naturalnym drewnem i funkcjonalnym układem przechowywania.",
    image:
      "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80",
    category: "Kuchnia",
    location: "Kraków",
  },
  {
    title: "Salon z charakterem",
    description:
      "Przestrzeń zaprojektowana z myślą o codziennym relaksie i eleganckim odbiorze.",
    image:
      "https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=1200&q=80",
    category: "Salon",
    location: "Niepołomice",
  },
  {
    title: "Zabudowa garderoby",
    description:
      "Minimalistyczne rozwiązanie z wykorzystaniem ciepłych materiałów i precyzyjnych detali.",
    image:
      "https://images.unsplash.com/photo-1484154218962-a197022b5858?auto=format&fit=crop&w=1200&q=80",
    category: "Garderoba",
    location: "Warszawa",
  },
];
---

<section
  id="realizacje"
  class="border-b border-stone-300/80 bg-stone-100 py-20 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <Reveal delay={0} class="flex items-center gap-4">
        <span class="text-[0.68rem] uppercase tracking-[0.38em] text-stone-500">
          1 Projects
        </span>
        <div class="flex-1">
          <Divider class="bg-stone-400" />
        </div>
      </Reveal>
    </div>

    <Reveal
      delay={140}
      class="relative overflow-hidden border border-stone-300/80 bg-stone-50 shadow-[0_12px_30px_rgba(41,33,26,0.04)]"
    >
      <div class="overflow-hidden">
        <div
          data-portfolio-track
          class="flex transition-transform duration-500 ease-out"
        >
          {
            items.map((item) => (
              <article class="min-w-full">
                <div class="relative h-[440px] sm:h-[520px]">
                  <img
                    src={item.image}
                    alt={item.title}
                    class="h-full w-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-stone-900/20 to-transparent" />

                  <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
                    <div class="mb-3 flex items-center justify-between gap-3 text-[0.64rem] uppercase tracking-[0.24em] text-stone-200/90">
                      <span>{item.category}</span>
                      <span>{item.location}</span>
                    </div>

                    <h3 class="max-w-md text-3xl font-medium leading-tight text-stone-50 sm:text-4xl">
                      {item.title}
                    </h3>
                    <p class="mt-3 max-w-lg text-sm leading-relaxed text-stone-200 sm:text-base">
                      {item.description}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div
        class="flex items-center justify-between gap-4 border-t border-stone-200 bg-stone-50 px-4 py-4 sm:px-5 sm:py-5"
      >
        <div data-portfolio-dots class="flex items-center gap-2">
          {
            items.map((_, index) => (
              <button
                type="button"
                data-dot={index}
                aria-label={`Pokaż realizację ${index + 1}`}
                class="h-2.5 w-2.5 border border-stone-500 bg-transparent transition-all duration-300"
              />
            ))
          }
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            data-portfolio-prev
            aria-label="Poprzednia realizacja"
            class="inline-flex h-10 w-10 items-center justify-center border border-stone-300 bg-white text-lg text-stone-900 transition hover:border-stone-900"
          >
            ←
          </button>
          <button
            type="button"
            data-portfolio-next
            aria-label="Następna realizacja"
            class="inline-flex h-10 w-10 items-center justify-center border border-stone-900 bg-stone-900 text-lg text-stone-50 transition hover:bg-stone-700"
          >
            →
          </button>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<script>
  const track = document.querySelector("[data-portfolio-track]");
  const dots = document.querySelectorAll("[data-dot]");
  const nextBtn = document.querySelector("[data-portfolio-next]");
  const prevBtn = document.querySelector("[data-portfolio-prev]");

  if (track && dots.length && nextBtn && prevBtn) {
    const slides = Array.from(track.children);
    let currentIndex = 0;

    const updateCarousel = (index: number) => {
      currentIndex = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === currentIndex;
        dot.classList.toggle("bg-stone-900", isActive);
        dot.classList.toggle("w-8", isActive);
        dot.classList.toggle("border-stone-900", isActive);
        dot.classList.toggle("bg-transparent", !isActive);
      });
    };

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        updateCarousel(Number(dot.getAttribute("data-dot")));
      });
    });

    nextBtn.addEventListener("click", () => updateCarousel(currentIndex + 1));
    prevBtn.addEventListener("click", () => updateCarousel(currentIndex - 1));

    updateCarousel(0);
  }
</script>
