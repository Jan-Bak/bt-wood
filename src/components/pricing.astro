---
import Divider from "./Divider.astro";
import Reveal from "./Reveal.astro";

const packages = [
  {
    name: "Essential",
    tagline: "Idealne na start",
    price: "od 8 900",
    unit: "PLN",
    highlight: false,
    features: [
      "Projekt koncepcyjny zabudowy",
      "Dobór materiałów bazowych",
      "Szafa lub regał na wymiar",
      "Montaż w lokalizacji klienta",
    ],
  },
  {
    name: "Comfort",
    tagline: "Sprawdzony wybór",
    price: "od 15 800",
    unit: "PLN",
    highlight: true,
    features: [
      "Pełny projekt z wizualizacjami",
      "Kuchnia lub garderoba na wymiar",
      "Blaty i fronty premium mid-range",
      "Koordynacja dostaw i montaż",
    ],
    note: "Najczęściej wybierany pakiet",
  },
  {
    name: "Premium",
    tagline: "Designerskie rozwiązania",
    price: "od 28 900",
    unit: "PLN",
    highlight: false,
    features: [
      "Indywidualny projekt wnętrza meblowego",
      "Naturalne forniry i spieki",
      "Kompleksowa zabudowa kilku stref",
      "Nadzór wykonawczy na każdym etapie",
    ],
  },
  {
    name: "Bespoke",
    tagline: "Bez ograniczeń",
    price: "indywidualnie",
    unit: "",
    highlight: false,
    features: [
      "Pełna swoboda materiałów i detali",
      "Nietypowe konstrukcje i formy",
      "Współpraca z architektem wnętrz",
      "Harmonogram dopasowany do inwestycji",
    ],
  },
];
---

<section id="pricing" class="border-b border-stone-300/80 bg-stone-100 py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Reveal delay={0} class="flex items-center gap-4">
      <span class="text-[0.68rem] uppercase tracking-[0.38em] text-stone-500">
        2 Wycena
      </span>
      <div class="flex-1">
        <Divider class="bg-stone-400" />
      </div>
    </Reveal>

    <div class="grid gap-8 pt-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-end lg:gap-16">
      <Reveal delay={120}>
        <p class="text-[0.65rem] uppercase tracking-[0.3em] text-stone-500">
          Pakiety
        </p>
        <h2
          class="mt-4 max-w-sm font-[family-name:var(--font-display)] text-5xl leading-none text-stone-900 sm:text-6xl"
        >
          Piękno bez chaosu, budżet pod kontrolą
        </h2>
      </Reveal>

      <Reveal delay={200}>
        <p class="max-w-xl text-base leading-relaxed text-stone-600">
          Przygotowaliśmy propozycje pakietów, które pomagają szybko zorientować
          się w zakresie i skali inwestycji. Ostateczna wycena zawsze powstaje
          po pomiarach i ustaleniu materiałów.
        </p>
      </Reveal>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {
        packages.map((pkg, index) => (
          <Reveal
            delay={240 + index * 80}
            class:list={[
              "flex h-full flex-col border p-6 sm:p-7",
              pkg.highlight
                ? "border-stone-900 bg-stone-900 text-stone-50"
                : "border-stone-300 bg-stone-50 text-stone-900",
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <p
                  class:list={[
                    "text-[0.62rem] uppercase tracking-[0.28em]",
                    pkg.highlight ? "text-stone-400" : "text-stone-500",
                  ]}
                >
                  {pkg.tagline}
                </p>
                <h3
                  class="mt-3 font-[family-name:var(--font-display)] text-3xl leading-none"
                >
                  {pkg.name}
                </h3>
              </div>
              {pkg.note && (
                <span class="border border-[#d7c7ac] px-2 py-1 text-[0.55rem] uppercase tracking-[0.18em] text-[#d7c7ac]">
                  Popularne
                </span>
              )}
            </div>

            <div class="mt-8">
              <p
                class:list={[
                  "text-[0.58rem] uppercase tracking-[0.24em]",
                  pkg.highlight ? "text-stone-400" : "text-stone-500",
                ]}
              >
                Orientacyjnie
              </p>
              <p class="mt-2 text-2xl font-medium tracking-tight">
                {pkg.price}
                {pkg.unit && (
                  <span
                    class:list={[
                      "ml-1 text-sm font-normal",
                      pkg.highlight ? "text-stone-400" : "text-stone-500",
                    ]}
                  >
                    {pkg.unit}
                  </span>
                )}
              </p>
            </div>

            <ul
              class:list={[
                "mt-8 flex-1 space-y-3 border-t pt-6 text-sm leading-relaxed",
                pkg.highlight
                  ? "border-stone-700 text-stone-300"
                  : "border-stone-200 text-stone-600",
              ]}
            >
              {pkg.features.map((feature) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-2 h-px w-3 shrink-0 bg-current opacity-50" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href="/i/#consultation"
              class:list={[
                "mt-8 inline-flex items-center justify-center px-4 py-3 text-[0.68rem] font-medium uppercase tracking-[0.22em] transition",
                pkg.highlight
                  ? "border border-[#d7c7ac] bg-[#d7c7ac] text-stone-900 hover:bg-[#e7d8bc]"
                  : "border border-stone-900 bg-stone-900 text-stone-50 hover:bg-stone-700",
              ]}
            >
              Szczegóły pakietu
            </a>
          </Reveal>
        ))
      }
    </div>

    <Reveal delay={420} class="mt-8">
      <p class="text-sm leading-relaxed text-stone-500">
        Większość klientów wybiera pakiet Comfort z zabudową kuchenną, aby
        otrzymać spójne, gotowe do życia rozwiązanie bez rozpraszania procesu
        na wielu wykonawców.
      </p>
    </Reveal>
  </div>
</section>
