---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-stone-200 bg-stone-50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
    {
      eyebrow && (
        <p class="text-[0.65rem] font-medium uppercase tracking-[0.2em] text-stone-500">
          {eyebrow}
        </p>
      )
    }
    <h1
      class="mt-3 max-w-3xl font-[family-name:var(--font-display)] text-4xl leading-tight text-stone-900 sm:text-5xl"
    >
      {title}
    </h1>
    {
      description && (
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg">
          {description}
        </p>
      )
    }
  </div>
</section>
