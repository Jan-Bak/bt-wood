---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-[var(--b2b-border)] bg-[var(--b2b-bg)]">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8">
    {eyebrow && <p class="b2b-eyebrow">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-3xl sm:text-4xl">{title}</h1>
    {
      description && (
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--b2b-muted)] sm:text-[1.05rem]">
          {description}
        </p>
      )
    }
  </div>
</section>
