---
import Divider from "./Divider.astro";
import Reveal from "./Reveal.astro";

const team = [
  {
    name: "Tomek",
    email: "tomasz@bt-woodstudio.com",
    phone: "791 374 837",
    accent: "#d7c7ac",
  },
  {
    name: "Bartek",
    email: "bartlomiej@bt-woodstudio.com",
    phone: "606 634 401",
    accent: "#c5b39a",
  },
];
---

<section id="kontakt" class="bg-stone-100 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Reveal delay={0} class="mb-10">
      <Divider class="mb-6" />
    </Reveal>

    <div class="grid gap-10 lg:grid-cols-[0.72fr_1.4fr] lg:items-start">
      <Reveal delay={120} class="space-y-5">
        <p class="text-[0.68rem] uppercase tracking-[0.38em] text-stone-500">
          01
        </p>
        <h2
          class="font-[family-name:var(--font-display)] text-5xl leading-none text-stone-900 sm:text-6xl"
        >
          Let’s Talk
        </h2>
        <p class="max-w-sm text-base leading-relaxed text-stone-600">
          Każdy projekt zaczyna się od rozmowy. Porozmawiajmy o Twoim.
        </p>
      </Reveal>

      <div class="grid gap-5 md:grid-cols-2">
        {
          team.map((person, index) => (
            <Reveal
              delay={180 + index * 120}
              class="border border-stone-300/80 bg-white p-6"
            >
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center text-sm font-medium text-stone-900"
                  style={`background: ${person.accent}`}
                >
                  {person.name.slice(0, 1)}
                </div>
                <h3 class="text-xl font-medium text-stone-900">
                  {person.name}
                </h3>
              </div>

              <ul class="mt-5 space-y-3 text-sm text-stone-700">
                <li>
                  <a
                    href={`mailto:${person.email}`}
                    class="transition hover:text-stone-900"
                  >
                    {person.email}
                  </a>
                </li>
                <li>
                  <a
                    href={`tel:${person.phone.replace(/\s+/g, "")}`}
                    class="transition hover:text-stone-900"
                  >
                    {person.phone}
                  </a>
                </li>
              </ul>
            </Reveal>
          ))
        }

        <Reveal
          delay={420}
          class="border border-stone-300/80 bg-stone-900 p-6 text-stone-100 md:col-span-2"
        >
          <p class="text-[0.65rem] uppercase tracking-[0.3em] text-stone-300">
            Dla klientów
          </p>

          <div
            class="mt-5 flex flex-col gap-4 text-sm leading-relaxed text-stone-200 md:flex-row md:items-end md:justify-between"
          >
            <div class="space-y-3">
              <p>Jesteśmy dostępni na WhatsApp i mailowo.</p>
              <p>
                BT Wood Studio<br />
                ul. Pionierów 5A<br />
                32-005 Niepołomice
              </p>
            </div>

            <a
              href="mailto:biuro@btwoodstudio.pl"
              class="inline-flex items-center justify-center border border-[#d7c7ac] bg-[#d7c7ac] px-4 py-3 text-[0.68rem] font-medium uppercase tracking-[0.22em] text-stone-900 transition hover:bg-[#e7d8bc]"
            >
              Skontaktuj się z nami
            </a>
          </div>
        </Reveal>
      </div>
    </div>
  </div>
</section>
