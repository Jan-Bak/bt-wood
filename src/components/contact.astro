---
import Divider from "./Divider.astro";
import Reveal from "./Reveal.astro";

const team = [
  {
    name: "Tomek",
    email: "t.chachlowski@bt-woodstudio.com",
    phone: "+48 791 374 837",
    accent: "#d7c7ac",
  },
  {
    name: "Bartek",
    email: "b.ciaston@bt-woodstudio.com",
    phone: "+48 606 634 401",
    accent: "#c5b39a",
  },
];
---

<section id="contact" class="bg-stone-100 py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Reveal delay={0} class="flex items-center gap-4">
      <span class="text-[0.68rem] uppercase tracking-[0.38em] text-stone-500">
        7 Dla klientów
      </span>
      <div class="flex-1">
        <Divider class="bg-stone-400" />
      </div>
    </Reveal>

    <div
      class="grid gap-10 pt-8 transition-all duration-300 ease-out lg:sticky lg:top-24 lg:grid-cols-[0.9fr_1.4fr] lg:items-start lg:origin-top-left lg:scale-[0.985]"
    >
      <div class="space-y-5">
        <Reveal delay={120} class="space-y-6">
          <div class="space-y-5">
            <h2
              class="font-[family-name:var(--font-display)] text-5xl leading-none text-stone-900 sm:text-6xl"
            >
              Dla klientów
            </h2>
            <p class="max-w-sm text-base leading-relaxed text-stone-600">
              Jesteśmy dostępni na WhatsApp i mailowo. Każdy projekt zaczyna się
              od rozmowy — porozmawiajmy o Twoim.
            </p>
          </div>

          <div
            class="border border-stone-300 bg-stone-50 p-5 text-sm text-stone-700"
          >
            <p
              class="text-[0.62rem] uppercase tracking-[0.25em] text-stone-500"
            >
              Kontakt
            </p>
            <ul class="mt-4 space-y-3">
              <li>
                <a
                  href="mailto:biuro@bt-woodstudio.com"
                  class="hover:text-stone-900"
                >
                  biuro@bt-woodstudio.com
                </a>
              </li>
              <li>
                <a href="tel:+48606634401" class="hover:text-stone-900">
                  +48 606 634 401
                </a>
              </li>
              <li>ul. Pionierów 5A, 32-005 Niepołomice</li>
            </ul>
          </div>
        </Reveal>

        <div class="space-y-4">
          {
            team.map((person, index) => (
              <Reveal
                delay={180 + index * 120}
                class="border border-stone-300 bg-stone-50 p-5 shadow-[0_0_0_1px_rgba(120,103,84,0.04)]"
              >
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <div
                      class="flex h-11 w-11 items-center justify-center text-sm font-medium text-stone-900"
                      style={`background: ${person.accent}`}
                    >
                      {person.name.slice(0, 1)}
                    </div>
                    <div>
                      <p class="text-[0.62rem] uppercase tracking-[0.24em] text-stone-500">
                        Kontakt
                      </p>
                      <h3 class="mt-1 text-xl font-medium text-stone-900">
                        {person.name}
                      </h3>
                    </div>
                  </div>
                  <span class="text-[0.58rem] uppercase tracking-[0.2em] text-stone-400">
                    {index === 0 ? "Studio" : "Projekt"}
                  </span>
                </div>

                <ul class="mt-5 space-y-3 border-t border-stone-200 pt-4 text-sm text-stone-700">
                  <li>
                    <a
                      href={`mailto:${person.email}`}
                      class="transition hover:text-stone-900"
                    >
                      {person.email}
                    </a>
                  </li>
                  <li>
                    <a
                      href={`tel:${person.phone.replace(/\s+/g, "")}`}
                      class="transition hover:text-stone-900"
                    >
                      {person.phone}
                    </a>
                  </li>
                </ul>
              </Reveal>
            ))
          }
        </div>
      </div>

      <div class="grid gap-5">
        <Reveal delay={420} class="border border-stone-300/80 bg-white p-6">
          <div class="mb-5 flex items-center justify-between gap-4">
            <p
              class="text-[0.68rem] uppercase tracking-[0.28em] text-stone-500"
            >
              Formularz
            </p>
          </div>

          <form id="contact-form" class="grid gap-4 md:grid-cols-2">
            <input
              type="hidden"
              name="access_key"
              value="4d09a857-0516-4681-bfeb-bd81309a649c"
            />
            <input
              type="hidden"
              name="from_name"
              value="BT Wood Studio — Klient indywidualny"
            />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              tabindex="-1"
              aria-hidden="true"
            />
            <label class="block text-sm text-stone-700 md:col-span-1">
              <span
                class="mb-2 block text-[0.62rem] uppercase tracking-[0.2em] text-stone-500"
              >
                Imię
              </span>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Twoje imię"
                class="w-full border border-stone-300 bg-stone-50 px-3 py-3 text-sm text-stone-900 outline-none placeholder:text-stone-400"
              />
            </label>

            <label class="block text-sm text-stone-700 md:col-span-1">
              <span
                class="mb-2 block text-[0.62rem] uppercase tracking-[0.2em] text-stone-500"
              >
                Email
              </span>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="twoj@email.com"
                class="w-full border border-stone-300 bg-stone-50 px-3 py-3 text-sm text-stone-900 outline-none placeholder:text-stone-400"
              />
            </label>

            <label class="block text-sm text-stone-700 md:col-span-2">
              <span
                class="mb-2 block text-[0.62rem] uppercase tracking-[0.2em] text-stone-500"
              >
                Temat
              </span>
              <input
                id="contact-subject"
                name="subject"
                type="text"
                required
                placeholder="Opisz temat zapytania"
                class="w-full border border-stone-300 bg-stone-50 px-3 py-3 text-sm text-stone-900 outline-none placeholder:text-stone-400"
              />
            </label>

            <label class="block text-sm text-stone-700 md:col-span-2">
              <span
                class="mb-2 block text-[0.62rem] uppercase tracking-[0.2em] text-stone-500"
              >
                Wiadomość
              </span>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder="Napisz, czego potrzebujesz..."
                class="w-full resize-none border border-stone-300 bg-stone-50 px-3 py-3 text-sm text-stone-900 outline-none placeholder:text-stone-400"
              ></textarea>
            </label>

            <div class="md:col-span-2 space-y-4 border-t border-stone-200 pt-4">
              <label class="flex items-start gap-3 text-sm text-stone-700">
                <input
                  name="privacy-consent"
                  type="checkbox"
                  required
                  class="mt-1 h-4 w-4 accent-[#8a6f52]"
                />
                <span>
                  Wyrażam zgodę na przetwarzanie moich danych osobowych w celu
                  odpowiedzi na zapytanie i kontaktu w sprawie realizacji
                  projektu.
                </span>
              </label>

              <label class="flex items-start gap-3 text-sm text-stone-700">
                <input
                  name="partner-consent"
                  type="checkbox"
                  required
                  class="mt-1 h-4 w-4 accent-[#8a6f52]"
                />
                <span>
                  Wyrażam zgodę na przekazanie moich danych do wybranych
                  partnerów lub podwykonawców realizujących usługę w zakresie
                  obsługi zapytania.
                </span>
              </label>

              <div
                class="border border-stone-200 bg-stone-50 p-4 text-sm text-stone-700"
              >
                <p
                  class="text-[0.62rem] uppercase tracking-[0.22em] text-stone-500"
                >
                  Administrator danych
                </p>
                <p class="mt-2 leading-relaxed">
                  BT Wood Studio, ul. Pionierów 5A, 32-005 Niepołomice.
                  Administrator przetwarza dane wyłącznie w celu obsługi
                  zapytania i realizacji współpracy.
                </p>
              </div>
            </div>

            <div class="md:col-span-2">
              <button
                type="submit"
                class="inline-flex items-center justify-center border border-[#d7c7ac] bg-[#d7c7ac] px-5 py-3 text-[0.68rem] font-medium uppercase tracking-[0.22em] text-stone-900 transition hover:bg-[#e7d8bc]"
              >
                Wyślij zapytanie
              </button>
              <p
                class="mt-3 text-sm text-stone-600"
                data-form-status
                role="status"
                aria-live="polite"
              >
              </p>
            </div>
          </form>
        </Reveal>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (!form) throw new Error("Individual contact form was not found.");

  const result = form.querySelector<HTMLElement>("[data-form-status]");
  const submitButton = form.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  if (!result || !submitButton) {
    throw new Error("Individual contact form status or button was not found.");
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    const originalButtonText = submitButton.textContent;
    result.textContent = "Wysyłanie...";
    submitButton.disabled = true;

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: new FormData(form),
      });
      const data: { success: boolean; message: string } = await response.json();

      if (data.success) {
        result.textContent = "Wiadomość została wysłana. Dziękujemy!";
        form.reset();
      } else {
        result.textContent = data.message;
      }
    } catch (error) {
      console.error("Web3Forms submission failed:", error);
      result.textContent =
        "Nie udało się wysłać wiadomości. Spróbuj ponownie lub napisz na biuro@bt-woodstudio.com.";
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = originalButtonText;
    }
  });
</script>
