---
import Reveal from "../components/Reveal.astro";

interface Props {
  class?: string;
  text: string;
}

const { class: className, text } = Astro.props;
---

<div
  class:list={[
    className,
    "mx-auto px-8 py-32 w-full bg-stone-900 text-stone-50 text-center text-2xl md:text-4xl",
  ]}
>
  <Reveal delay={0} class="inline-block">
    <h2>{text}</h2>
  </Reveal>
</div>
