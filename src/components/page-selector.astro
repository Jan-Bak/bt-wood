---
interface Props {
  name: string;
  description?: string;
  linkTo?: string;
  image?: string | ImageMetadata;
}

const { name, description, linkTo = "/", image } = Astro.props;
---

<a
  href={linkTo}
  class="group relative flex h-full w-full cursor-pointer items-center justify-center overflow-hidden bg-stone-200 p-4 text-inherit no-underline shadow-sm ring-1 ring-black/5 transition-all duration-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-stone-500/60 md:h-full md:min-h-0 md:rounded-none md:shadow-none md:ring-0"
>
  {
    image && (
      <img
        src={typeof image === "string" ? image : image.src}
        alt={name}
        class="absolute inset-0 h-full w-full object-cover transition-all duration-500 group-hover:scale-110 group-hover:brightness-75"
      />
    )
  }

  <div
    class="absolute inset-0 bg-stone-950/45 transition-colors duration-300 group-hover:bg-stone-950/60"
  >
  </div>

  <div
    class="relative z-10 flex max-w-[90%] flex-col items-center justify-center text-center text-stone-50"
  >
    <span
      class="inline-flex items-center rounded-full border border-white/25 bg-white/10 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.18em] text-stone-100 backdrop-blur-sm"
    >
      Wybierz
    </span>
    <span
      class="mt-4 text-2xl font-semibold leading-tight sm:text-3xl md:text-4xl"
    >
      {name}
    </span>
    {
      description && (
        <p class="mt-2 max-w-md text-sm leading-relaxed text-stone-100/90 sm:text-base">
          {description}
        </p>
      )
    }
  </div>
</a>
