---
const currentYear = new Date().getFullYear();

const links = [
  { label: "Usługi", href: "/b2b/services" },
  { label: "Montaż", href: "/b2b/assembly" },
  { label: "Projekty", href: "/b2b/projects" },
  { label: "Kontakt", href: "/b2b/contact" },
];

const mapLinks = {
  google:
    "https://www.google.com/maps/search/?api=1&query=BT-Woodstudio%20Pionier%C3%B3w%205A%2C%2032-005%20Niepo%C5%82omice",
  apple:
    "https://maps.apple.com/?q=BT-Woodstudio+Pionier%C3%B3w+5A+32-005+Niepo%C5%82omice",
};

---

<footer
  class="border-t border-[var(--b2b-border)] bg-[var(--b2b-dark)] text-white"
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <p class="text-sm font-semibold tracking-wide">BT Wood Studio</p>
        <p
          class="mt-3 max-w-xs text-sm leading-relaxed text-[var(--b2b-silver)]"
        >
          Od 2012 roku realizujemy projekty stolarskie dla firm, salonów i
          partnerów branżowych - od nestingu CNC po montaż.
        </p>
      </div>

      <div>
        <p
          class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[var(--b2b-blue)]"
        >
          Szybkie linki
        </p>
        <ul class="mt-3 space-y-2 text-sm text-[var(--b2b-silver)]">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p
          class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[var(--b2b-blue)]"
        >
          Kontakt B2B
        </p>
        <ul class="mt-3 space-y-2 text-sm text-[var(--b2b-silver)]">
          <li>
            <a href="mailto:biuro@bt-woodstudio.com" class="hover:text-white">
              biuro@bt-woodstudio.com
            </a>
          </li>
          <li>
            <a href="tel:+48606634401" class="hover:text-white">
              +48 606 634 401
            </a>
          </li>
          <li>ul. Pionierów 5A, 32-005 Niepołomice</li>
          <li class="flex flex-wrap gap-2 pt-1">
            <a
              href={mapLinks.google}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center border border-white/30 px-3 py-2 text-[0.62rem] font-medium uppercase tracking-[0.16em] text-white transition hover:border-[var(--b2b-blue)] hover:text-[var(--b2b-blue)]"
            >
              Google Maps
            </a>
            <a
              href={mapLinks.apple}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center border border-white/30 px-3 py-2 text-[0.62rem] font-medium uppercase tracking-[0.16em] text-white transition hover:border-[var(--b2b-blue)] hover:text-[var(--b2b-blue)]"
            >
              Apple Maps
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-2 border-t border-white/10 pt-5 text-[0.68rem] text-[var(--b2b-silver)] sm:flex-row sm:justify-between"
    >
      <span>© {currentYear} BT Wood Studio</span>
      <a href="/i" class="hover:text-white">Klient indywidualny</a>
    </div>
  </div>
</footer>
