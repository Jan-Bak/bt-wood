---
import logo from "../../assets/logo.png";
import { Image } from "astro:assets";

const navItems = [
  { label: "Strona główna", href: "/b2b/" },
  { label: "Realizacje", href: "/b2b/realizacje" },
  { label: "Projekty", href: "/b2b/projekty" },
  { label: "Usługi", href: "/b2b/uslugi" },
  { label: "Montaż", href: "/b2b/montaz" },
  { label: "Partnerzy", href: "/b2b/partnerzy" },
  { label: "Kontakt", href: "/b2b/kontakt", primary: true },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/b2b";
---

<header
  class="sticky top-0 z-50 border-b border-[var(--b2b-border)] bg-white/95 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
  >
    <a
      href="/b2b/"
      class="flex items-center gap-3"
      aria-label="BT Wood Studio B2B"
    >
      <Image
        src={logo}
        alt="BT Wood Studio B2B logo"
        class="h-9 w-9 object-contain"
      />
      <div class="leading-tight">
        <p
          class="text-[0.78rem] font-semibold tracking-wide text-[var(--b2b-ink)]"
        >
          BT Wood Studio
        </p>
        <p
          class="text-[0.68rem] font-medium tracking-wide text-[var(--b2b-blue-dark)]"
        >
          Współpraca B2B
        </p>
      </div>
    </a>

    <nav aria-label="Nawigacja B2B" class="hidden items-center gap-0.5 lg:flex">
      {
        navItems.map((item) => {
          const hrefPath = item.href.replace(/\/$/, "") || "/b2b";
          const active =
            pathname === hrefPath ||
            (hrefPath !== "/b2b" && pathname.startsWith(hrefPath));
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "px-3 py-2 text-[0.78rem] font-medium transition",
                item.primary
                  ? "b2b-btn !py-2"
                  : active
                    ? "bg-[rgba(64,188,244,0.12)] text-[var(--b2b-ink)]"
                    : "text-[var(--b2b-muted)] hover:bg-[var(--b2b-bg)] hover:text-[var(--b2b-ink)]",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <button
      type="button"
      class="text-[0.78rem] font-semibold text-[var(--b2b-ink)] lg:hidden"
      aria-expanded="false"
      aria-controls="b2b-mobile-nav"
      data-b2b-menu
    >
      Menu
    </button>
  </div>
</header>

<div
  id="b2b-mobile-nav"
  data-b2b-panel
  role="dialog"
  aria-modal="true"
  aria-label="Menu mobilne B2B"
  inert
  class="fixed inset-0 z-40 hidden bg-white lg:hidden"
>
  <div class="flex h-full flex-col px-4 pb-8 pt-20">
    <button
      type="button"
      data-b2b-menu-close
      class="absolute right-4 top-3 inline-flex min-h-11 min-w-11 items-center justify-center text-[0.78rem] font-semibold text-[var(--b2b-ink)]"
      aria-label="Zamknij menu mobilne"
    >
      <span aria-hidden="true">×</span><span class="ml-2">Zamknij</span>
    </button>
    <nav aria-label="Menu mobilne B2B" class="space-y-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "block border-b border-[var(--b2b-border)] px-2 py-4 text-base font-medium",
              item.primary
                ? "text-[var(--b2b-blue-dark)]"
                : "text-[var(--b2b-ink)]",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href="/" class="b2b-btn-ghost mt-auto text-center">
      Wróć do wyboru ścieżki
    </a>
  </div>
</div>

<script>
  const button = document.querySelector(
    "[data-b2b-menu]",
  ) as HTMLButtonElement | null;
  const panel = document.querySelector("[data-b2b-panel]");
  const closeButton = document.querySelector(
    "[data-b2b-menu-close]",
  ) as HTMLButtonElement | null;

  if (button && panel) {
    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("hidden", !open);
      panel.toggleAttribute("inert", !open);
      document.body.classList.toggle("overflow-hidden", open);
      if (open) {
        closeButton?.focus();
      } else {
        button.focus();
      }
    };

    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true";
      setOpen(!open);
    });

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    closeButton?.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);

      if (
        event.key !== "Tab" ||
        button.getAttribute("aria-expanded") !== "true"
      ) {
        return;
      }

      const focusable = Array.from(
        panel.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
      );
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
