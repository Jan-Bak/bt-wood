---
import Layout from "../Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Usługi stolarskie B2B: nesting CNC, oklejanie, projektowanie, montaż mebli. BT Wood Studio, Niepołomice.",
} = Astro.props;
---

<Layout title={`${title} | BT Wood Studio B2B`} description={description}>
  <div class="flex min-h-screen flex-col bg-white text-stone-800">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </div>
</Layout>
