---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "BT wood", description = "Meble na wymiar" } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body class="absolute">
    <slot />
  </body>
</html>
