---
import B2BLayout from "../../layouts/b2b/Layout.astro";

const capabilities = [
  {
    title: "Centrum nestingu",
    subtitle: "Usługi CNC",
    href: "/b2b/uslugi",
    description:
      "Precyzyjne cięcie płyt na centrum nestingowym — optymalizacja rozkroju i powtarzalność serii.",
  },
  {
    title: "Oklejanie płyt",
    subtitle: "Idealna krawędź",
    href: "/b2b/uslugi",
    description:
      "Oklejanie ABS / PVC z dbałością o jakość krawędzi pod meble kontraktowe i detaliczne.",
  },
  {
    title: "Projektowanie",
    subtitle: "Od projektu po realizację",
    href: "/b2b/projekty",
    description:
      "Wsparcie projektowe CAD, przygotowanie dokumentacji i wycena pod produkcję.",
  },
  {
    title: "Pomiar pomieszczeń",
    subtitle: "Inwentaryzacja",
    href: "/b2b/uslugi",
    description:
      "Pomiary na obiekcie przed produkcją — mniej poprawek, lepsze dopasowanie zabudowy.",
  },
  {
    title: "Montaż mebli",
    subtitle: "Festool / SEP",
    href: "/b2b/montaz",
    description:
      "Montaż mebli kuchennych, biurowych i niestandardowych oraz podłączenia AGD.",
  },
  {
    title: "Cięcie i oklejanie",
    subtitle: "Usługa produkcyjna",
    href: "/b2b/uslugi",
    description:
      "Realizacja na zlecenie: rozkrój, oklejanie i przygotowanie elementów do montażu.",
  },
  {
    title: "Oprogramowanie CAD",
    subtitle: "Dokumentacja",
    href: "/b2b/projekty",
    description:
      "Przygotowanie plików i rysunków pod nestowanie oraz produkcję seryjną.",
  },
  {
    title: "Wycena projektów",
    subtitle: "Oferta B2B",
    href: "/b2b/kontakt",
    description:
      "Szybka wycena na podstawie rysunków, list materiałowych lub pomiarów.",
  },
];
---

<B2BLayout
  title="Współpraca B2B"
  description="Od 2012 roku tworzymy meble z pasją — nesting CNC, oklejanie, projektowanie i montaż dla partnerów biznesowych."
>
  <section class="border-b border-stone-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8 lg:py-16">
      <p class="text-[0.65rem] font-medium uppercase tracking-[0.2em] text-stone-500">
        BT Wood Studio · B2B
      </p>
      <h1
        class="mt-4 max-w-3xl font-[family-name:var(--font-display)] text-4xl leading-tight text-stone-900 sm:text-5xl"
      >
        Produkcja stolarska i montaż dla firm
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg">
        Od 2012 roku tworzymy meble z pasją, łącząc doświadczenie, precyzję i
        nowoczesne rozwiązania stolarskie. Dzięki wysokiej jakości usług,
        dbałości o detale oraz nowoczesnemu parkowi maszynowemu realizujemy
        projekty spełniające oczekiwania nawet najbardziej wymagających
        klientów. Zapraszamy do współpracy.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/b2b/kontakt"
          class="inline-flex items-center justify-center bg-stone-900 px-5 py-3 text-[0.7rem] font-medium uppercase tracking-[0.16em] text-stone-50 transition hover:bg-stone-700"
        >
          Skontaktuj się
        </a>
        <a
          href="/b2b/uslugi"
          class="inline-flex items-center justify-center border border-stone-300 px-5 py-3 text-[0.7rem] font-medium uppercase tracking-[0.16em] text-stone-700 transition hover:border-stone-900 hover:text-stone-900"
        >
          Zobacz usługi
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-stone-200 bg-stone-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-[0.65rem] uppercase tracking-[0.18em] text-stone-500">
            Kompetencje
          </p>
          <h2
            class="mt-2 font-[family-name:var(--font-display)] text-3xl text-stone-900 sm:text-4xl"
          >
            Co oferujemy partnerom
          </h2>
        </div>
        <a
          href="/b2b/partnerzy"
          class="text-sm text-stone-600 underline-offset-4 hover:text-stone-900 hover:underline"
        >
          Współpracujący partnerzy →
        </a>
      </div>

      <div class="mt-8 grid gap-px border border-stone-200 bg-stone-200 sm:grid-cols-2 lg:grid-cols-4">
        {
          capabilities.map((item) => (
            <a
              href={item.href}
              class="group flex h-full flex-col bg-white p-5 transition hover:bg-stone-50 sm:p-6"
            >
              <p class="text-[0.62rem] uppercase tracking-[0.16em] text-stone-500">
                {item.subtitle}
              </p>
              <h3 class="mt-2 text-lg font-medium text-stone-900 group-hover:underline">
                {item.title}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600">
                {item.description}
              </p>
              <span class="mt-5 text-[0.68rem] uppercase tracking-[0.14em] text-stone-500 group-hover:text-stone-900">
                Szczegóły →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div class="border border-stone-200 bg-stone-50 p-6 sm:p-8">
        <p class="text-[0.65rem] uppercase tracking-[0.18em] text-stone-500">
          Realizacje
        </p>
        <h2
          class="mt-2 font-[family-name:var(--font-display)] text-3xl text-stone-900"
        >
          Nasze realizacje
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-stone-600">
          Przegląd wybranych realizacji produkcyjnych i montażowych dla
          klientów biznesowych.
        </p>
        <a
          href="/b2b/realizacje"
          class="mt-6 inline-flex text-[0.7rem] uppercase tracking-[0.14em] text-stone-900 underline-offset-4 hover:underline"
        >
          Przejdź do realizacji →
        </a>
      </div>
      <div class="border border-stone-200 bg-white p-6 sm:p-8">
        <p class="text-[0.65rem] uppercase tracking-[0.18em] text-stone-500">
          Kontakt
        </p>
        <h2
          class="mt-2 font-[family-name:var(--font-display)] text-3xl text-stone-900"
        >
          Bądź z nami w kontakcie
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-stone-600">
          Skontaktuj się z nami:
          <a
            href="mailto:biuro@bt-woodstudio.com"
            class="font-medium text-stone-900 hover:underline"
          >
            biuro@bt-woodstudio.com
          </a>
        </p>
        <a
          href="/b2b/kontakt"
          class="mt-6 inline-flex bg-stone-900 px-4 py-3 text-[0.7rem] uppercase tracking-[0.14em] text-stone-50 hover:bg-stone-700"
        >
          Formularz / zespół
        </a>
      </div>
    </div>
  </section>
</B2BLayout>
