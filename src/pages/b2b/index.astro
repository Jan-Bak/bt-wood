---
import B2BLayout from "../../layouts/b2b/Layout.astro";
import { b2bImages } from "../../data/b2b-images";

const capabilities = [
  {
    title: "Centrum nestingu",
    subtitle: "Usługi CNC",
    href: "/b2b/uslugi",
    description:
      "Precyzyjne cięcie płyt na centrum nestingowym — optymalizacja rozkroju i powtarzalność serii.",
    image: b2bImages.home[0],
  },
  {
    title: "Oklejanie płyt",
    subtitle: "Idealna krawędź",
    href: "/b2b/uslugi",
    description:
      "Oklejanie ABS / PVC z dbałością o jakość krawędzi pod meble kontraktowe i detaliczne.",
    image: b2bImages.home[1],
  },
  {
    title: "Projektowanie",
    subtitle: "Od projektu po realizację",
    href: "/b2b/projekty",
    description:
      "Wsparcie projektowe CAD, przygotowanie dokumentacji i wycena pod produkcję.",
    image: b2bImages.home[2],
  },
  {
    title: "Pomiar pomieszczeń",
    subtitle: "Inwentaryzacja",
    href: "/b2b/uslugi",
    description:
      "Pomiary na obiekcie przed produkcją — mniej poprawek, lepsze dopasowanie zabudowy.",
    image: b2bImages.home[3],
  },
  {
    title: "Montaż mebli",
    subtitle: "Festool / SEP",
    href: "/b2b/montaz",
    description:
      "Montaż mebli kuchennych, biurowych i niestandardowych oraz podłączenia AGD.",
    image: b2bImages.home[4],
  },
  {
    title: "Cięcie i oklejanie",
    subtitle: "Usługa produkcyjna",
    href: "/b2b/uslugi",
    description:
      "Realizacja na zlecenie: rozkrój, oklejanie i przygotowanie elementów do montażu.",
    image: b2bImages.home[5],
  },
  {
    title: "Oprogramowanie CAD",
    subtitle: "Dokumentacja",
    href: "/b2b/projekty",
    description:
      "Przygotowanie plików i rysunków pod nestowanie oraz produkcję seryjną.",
    image: b2bImages.home[6],
  },
  {
    title: "Wycena projektów",
    subtitle: "Oferta B2B",
    href: "/b2b/kontakt",
    description:
      "Szybka wycena na podstawie rysunków, list materiałowych lub pomiarów.",
    image: b2bImages.home[7],
  },
];
---

<B2BLayout
  title="Współpraca B2B"
  description="Od 2012 roku tworzymy meble z pasją — nesting CNC, oklejanie, projektowanie i montaż dla partnerów biznesowych."
>
  <section class="border-b border-[var(--b2b-border)]">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8 lg:py-16">
      <div>
        <p class="b2b-eyebrow">BT Wood Studio · B2B</p>
        <h1 class="mt-3 text-3xl sm:text-4xl lg:text-[2.75rem]">
          Produkcja stolarska i montaż dla firm
        </h1>
        <p class="mt-5 max-w-xl text-[1.05rem] leading-relaxed text-[var(--b2b-muted)]">
          Od 2012 roku tworzymy meble z pasją, łącząc doświadczenie, precyzję i
          nowoczesne rozwiązania stolarskie. Dzięki wysokiej jakości usług,
          dbałości o detale oraz nowoczesnemu parkowi maszynowemu realizujemy
          projekty spełniające oczekiwania nawet najbardziej wymagających
          klientów. Zapraszamy do współpracy.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/b2b/kontakt" class="b2b-btn">Skontaktuj się</a>
          <a href="/b2b/uslugi" class="b2b-btn-ghost">Zobacz usługi</a>
        </div>
      </div>

      <div class="relative overflow-hidden border border-[var(--b2b-border)] bg-[var(--b2b-bg)]">
        <img
          src={b2bImages.home[0]}
          alt="BT Wood Studio — produkcja B2B"
          class="aspect-[4/3] h-full w-full object-cover"
        />
        <div
          class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[var(--b2b-dark)]/80 to-transparent p-5"
        >
          <p class="text-sm font-medium text-white">
            Centrum nestingu · CNC · Montaż
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[var(--b2b-bg)]">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="b2b-eyebrow">Kompetencje</p>
          <h2 class="mt-2 text-2xl sm:text-3xl">Co oferujemy partnerom</h2>
        </div>
        <a href="/b2b/partnerzy" class="b2b-link text-sm">
          Współpracujący partnerzy →
        </a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          capabilities.map((item) => (
            <a
              href={item.href}
              class="b2b-card group flex h-full flex-col overflow-hidden transition hover:border-[var(--b2b-blue)]"
            >
              <div class="aspect-[16/10] overflow-hidden bg-[var(--b2b-bg)]">
                <img
                  src={item.image}
                  alt={item.title}
                  class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-1 flex-col p-4">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--b2b-blue-dark)]">
                  {item.subtitle}
                </p>
                <h3 class="mt-1 text-base font-semibold">{item.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--b2b-muted)]">
                  {item.description}
                </p>
                <span class="mt-4 text-[0.72rem] font-semibold text-[var(--b2b-blue-dark)]">
                  Szczegóły →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto grid max-w-6xl gap-4 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div class="b2b-card p-6 sm:p-8">
        <p class="b2b-eyebrow">Realizacje</p>
        <h2 class="mt-2 text-2xl">Nasze realizacje</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--b2b-muted)]">
          Przegląd wybranych realizacji produkcyjnych i montażowych dla klientów
          biznesowych.
        </p>
        <a href="/b2b/realizacje" class="b2b-link mt-6 inline-flex text-sm">
          Przejdź do realizacji →
        </a>
      </div>
      <div class="border border-[var(--b2b-border)] bg-[var(--b2b-dark)] p-6 text-white sm:p-8">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[var(--b2b-blue)]">
          Kontakt
        </p>
        <h2 class="mt-2 text-2xl text-white">Bądź z nami w kontakcie</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--b2b-silver)]">
          Skontaktuj się z nami:
          <a href="mailto:biuro@bt-woodstudio.com" class="b2b-link text-[var(--b2b-blue)]">
            biuro@bt-woodstudio.com
          </a>
        </p>
        <a href="/b2b/kontakt" class="b2b-btn mt-6 inline-flex">
          Formularz / zespół
        </a>
      </div>
    </div>
  </section>
</B2BLayout>
