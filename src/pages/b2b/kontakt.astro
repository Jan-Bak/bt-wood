---
import B2BLayout from "../../layouts/b2b/Layout.astro";
import PageHero from "../../components/b2b/PageHero.astro";
import { Image } from "astro:assets";
import cncImage from "../../assets/next_cnc.webp";

const team = [
  {
    name: "Tomek",
    email: "tomasz@bt-woodstudio.com",
    phone: "+48 791 374 837",
    phoneHref: "+48791374837",
    image: cncImage,
  },
  {
    name: "Bartek",
    email: "bartlomiej@bt-woodstudio.com",
    phone: "+48 606 634 401",
    phoneHref: "+48606634401",
    image: cncImage,
  },
];

const mapLinks = {
  google:
    "https://www.google.com/maps/search/?api=1&query=BT-Woodstudio%20Pionier%C3%B3w%205A%2C%2032-005%20Niepo%C5%82omice",
  apple:
    "https://maps.apple.com/?q=BT-Woodstudio+Pionier%C3%B3w+5A+32-005+Niepo%C5%82omice",
};
---

<B2BLayout
  title="Kontakt"
  description="Kontakt B2B BT Wood Studio — Tomek, Bartek, biuro@bt-woodstudio.com, Niepołomice."
>
  <PageHero
    eyebrow="Kontakt"
    title="Kontakt"
    description="Poznaj zespół i umów współpracę produkcyjną lub montażową."
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-4">
        <article
          class="border border-[var(--b2b-border)] bg-[var(--b2b-bg)] p-6"
        >
          <p class="b2b-eyebrow">Biuro</p>
          <a
            href="mailto:biuro@bt-woodstudio.com"
            class="mt-3 block text-lg font-semibold text-[var(--b2b-blue-dark)] hover:underline"
          >
            biuro@bt-woodstudio.com
          </a>
          <div class="mt-5 text-sm leading-relaxed text-[var(--b2b-muted)]">
            <p
              class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--b2b-subtle)]"
            >
              Dojazd
            </p>
            <p class="mt-2">
              ul. Pionierów 5A<br />
              32-005 Niepołomice
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a
                href={mapLinks.google}
                target="_blank"
                rel="noopener noreferrer"
                class="b2b-btn-ghost !px-3 !py-2 !text-[0.62rem]"
              >
                Google Maps
              </a>
              <a
                href={mapLinks.apple}
                target="_blank"
                rel="noopener noreferrer"
                class="b2b-btn-ghost !px-3 !py-2 !text-[0.62rem]"
              >
                Apple Maps
              </a>
            </div>
          </div>
        </article>

        {
          team.map((person) => (
            <article class="b2b-card overflow-hidden">
              <div class="grid sm:grid-cols-[120px_1fr]">
                <div class="aspect-square bg-[var(--b2b-bg)] sm:aspect-auto">
                  <Image
                    src={person.image}
                    alt={person.name}
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="p-5">
                  <p class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--b2b-blue-dark)]">
                    Wizytówka
                  </p>
                  <h2 class="mt-1 text-xl font-semibold">{person.name}</h2>
                  <ul class="mt-3 space-y-1.5 text-sm text-[var(--b2b-muted)]">
                    <li>
                      <a href={`mailto:${person.email}`} class="b2b-link">
                        {person.email}
                      </a>
                    </li>
                    <li>
                      <a
                        href={`tel:${person.phoneHref}`}
                        class="hover:text-[var(--b2b-ink)]"
                      >
                        TEL: {person.phone}
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <article class="b2b-card p-6 sm:p-8">
        <p class="b2b-eyebrow">Zapytanie B2B</p>
        <h2 class="mt-2 text-2xl font-semibold">Napisz w sprawie współpracy</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--b2b-muted)]">
          Opisz zakres (nesting, oklejanie, montaż, projekt) — odezwiemy się z
          kolejnymi krokami.
        </p>

        <form class="mt-6 grid gap-4">
          <label class="block text-sm">
            <span
              class="mb-2 block text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--b2b-subtle)]"
            >
              Firma / Imię
            </span>
            <input
              id="b2b-contact-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Nazwa firmy lub imię"
              class="b2b-input"
            />
          </label>
          <label class="block text-sm">
            <span
              class="mb-2 block text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--b2b-subtle)]"
            >
              Email
            </span>
            <input
              id="b2b-contact-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="firma@email.com"
              class="b2b-input"
            />
          </label>
          <label class="block text-sm">
            <span
              class="mb-2 block text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--b2b-subtle)]"
            >
              Temat
            </span>
            <input
              id="b2b-contact-subject"
              name="subject"
              type="text"
              placeholder="np. wycena nestingu / montaż kuchni"
              class="b2b-input"
            />
          </label>
          <label class="block text-sm">
            <span
              class="mb-2 block text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--b2b-subtle)]"
            >
              Wiadomość
            </span>
            <textarea
              id="b2b-contact-message"
              name="message"
              rows="6"
              placeholder="Zakres prac, terminy, załączniki do przesłania mailowo..."
              class="b2b-input resize-y"></textarea>
          </label>

          <div class="space-y-4 border-t border-[var(--b2b-border)] pt-4">
            <label
              class="flex items-start gap-3 text-sm leading-relaxed text-[var(--b2b-muted)]"
            >
              <input
                name="privacy-consent"
                type="checkbox"
                class="mt-1 h-4 w-4 shrink-0 accent-[var(--b2b-blue-dark)]"
              />
              <span>
                Wyrażam zgodę na przetwarzanie moich danych osobowych w celu
                odpowiedzi na zapytanie i kontaktu w sprawie współpracy.
              </span>
            </label>

            <label
              class="flex items-start gap-3 text-sm leading-relaxed text-[var(--b2b-muted)]"
            >
              <input
                name="partner-consent"
                type="checkbox"
                class="mt-1 h-4 w-4 shrink-0 accent-[var(--b2b-blue-dark)]"
              />
              <span>
                Wyrażam zgodę na przekazanie moich danych wybranym partnerom lub
                podwykonawcom, jeśli jest to potrzebne do obsługi zapytania.
              </span>
            </label>

            <div
              class="border border-[var(--b2b-border)] bg-[var(--b2b-bg)] p-4 text-sm leading-relaxed text-[var(--b2b-muted)]"
            >
              <p
                class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--b2b-subtle)]"
              >
                Administrator danych
              </p>
              <p class="mt-2">
                BT Wood Studio, ul. Pionierów 5A, 32-005 Niepołomice.
                Administrator przetwarza dane wyłącznie w celu obsługi zapytania
                i realizacji współpracy.
              </p>
            </div>
          </div>

          <button type="button" class="b2b-btn w-full sm:w-auto">
            Wyślij zapytanie
          </button>
        </form>
      </article>
    </div>
  </section>
</B2BLayout>
