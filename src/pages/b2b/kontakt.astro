---
import B2BLayout from "../../layouts/b2b/Layout.astro";
import PageHero from "../../components/b2b/PageHero.astro";

const team = [
  {
    name: "Tomek",
    email: "tomasz@bt-woodstudio.com",
    phone: "+48 791 374 837",
    phoneHref: "+48791374837",
  },
  {
    name: "Bartek",
    email: "bartlomiej@bt-woodstudio.com",
    phone: "+48 606 634 401",
    phoneHref: "+48606634401",
  },
];
---

<B2BLayout
  title="Kontakt"
  description="Kontakt B2B BT Wood Studio — Tomek, Bartek, biuro@bt-woodstudio.com, Niepołomice."
>
  <PageHero
    eyebrow="Kontakt"
    title="Kontakt"
    description="Poznaj zespół i umów współpracę produkcyjną lub montażową."
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-4">
        <article class="border border-stone-200 bg-stone-50 p-6">
          <p class="text-[0.62rem] uppercase tracking-[0.16em] text-stone-500">
            Biuro
          </p>
          <a
            href="mailto:biuro@bt-woodstudio.com"
            class="mt-3 block text-lg font-medium text-stone-900 hover:underline"
          >
            biuro@bt-woodstudio.com
          </a>
          <div class="mt-5 text-sm leading-relaxed text-stone-600">
            <p class="text-[0.62rem] uppercase tracking-[0.16em] text-stone-500">
              Dojazd
            </p>
            <p class="mt-2">
              ul. Pionierów 5A<br />
              32-005 Niepołomice
            </p>
          </div>
        </article>

        {
          team.map((person) => (
            <article class="border border-stone-200 bg-white p-6">
              <p class="text-[0.62rem] uppercase tracking-[0.16em] text-stone-500">
                Wizytówka
              </p>
              <h2 class="mt-2 text-2xl font-medium text-stone-900">
                {person.name}
              </h2>
              <ul class="mt-4 space-y-2 text-sm text-stone-700">
                <li>
                  <a href={`mailto:${person.email}`} class="hover:underline">
                    {person.email}
                  </a>
                </li>
                <li>
                  <a href={`tel:${person.phoneHref}`} class="hover:underline">
                    TEL: {person.phone}
                  </a>
                </li>
              </ul>
            </article>
          ))
        }
      </div>

      <article class="border border-stone-200 bg-white p-6 sm:p-8">
        <p class="text-[0.65rem] uppercase tracking-[0.16em] text-stone-500">
          Zapytanie B2B
        </p>
        <h2 class="mt-2 text-2xl font-medium text-stone-900">
          Napisz w sprawie współpracy
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-stone-600">
          Opisz zakres (nesting, oklejanie, montaż, projekt) — odezwiemy się z
          kolejnymi krokami.
        </p>

        <form class="mt-6 grid gap-4">
          <label class="block text-sm text-stone-700">
            <span class="mb-2 block text-[0.62rem] uppercase tracking-[0.14em] text-stone-500">
              Firma / Imię
            </span>
            <input
              type="text"
              placeholder="Nazwa firmy lub imię"
              class="w-full border border-stone-300 bg-stone-50 px-3 py-3 text-sm outline-none focus:border-stone-900"
            />
          </label>
          <label class="block text-sm text-stone-700">
            <span class="mb-2 block text-[0.62rem] uppercase tracking-[0.14em] text-stone-500">
              Email
            </span>
            <input
              type="email"
              placeholder="firma@email.com"
              class="w-full border border-stone-300 bg-stone-50 px-3 py-3 text-sm outline-none focus:border-stone-900"
            />
          </label>
          <label class="block text-sm text-stone-700">
            <span class="mb-2 block text-[0.62rem] uppercase tracking-[0.14em] text-stone-500">
              Temat
            </span>
            <input
              type="text"
              placeholder="np. wycena nestingu / montaż kuchni"
              class="w-full border border-stone-300 bg-stone-50 px-3 py-3 text-sm outline-none focus:border-stone-900"
            />
          </label>
          <label class="block text-sm text-stone-700">
            <span class="mb-2 block text-[0.62rem] uppercase tracking-[0.14em] text-stone-500">
              Wiadomość
            </span>
            <textarea
              rows="6"
              placeholder="Zakres prac, terminy, załączniki do przesłania mailowo..."
              class="w-full resize-y border border-stone-300 bg-stone-50 px-3 py-3 text-sm outline-none focus:border-stone-900"
            ></textarea>
          </label>
          <button
            type="button"
            class="inline-flex w-full items-center justify-center bg-stone-900 px-5 py-3 text-[0.7rem] font-medium uppercase tracking-[0.14em] text-stone-50 hover:bg-stone-700 sm:w-auto"
          >
            Wyślij zapytanie
          </button>
        </form>
      </article>
    </div>
  </section>
</B2BLayout>
