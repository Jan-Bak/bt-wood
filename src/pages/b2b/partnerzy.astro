---
import B2BLayout from "../../layouts/b2b/Layout.astro";
import PageHero from "../../components/b2b/PageHero.astro";

const partnerTypes = [
  {
    title: "Salony meblowe",
    description:
      "Wsparcie produkcyjne i montażowe dla ekspozycji oraz realizacji u klientów końcowych.",
  },
  {
    title: "Producenci i stolarnie",
    description:
      "Outsourcing nestingu CNC, oklejania i przygotowania elementów pod Waszą montażownię.",
  },
  {
    title: "Architekci i generalni wykonawcy",
    description:
      "Zabudowy kontraktowe, pomiary, dokumentacja CAD i terminowa realizacja na obiekcie.",
  },
  {
    title: "Dostawcy płyt i okuć",
    description:
      "Stała współpraca materiałowa zapewniająca powtarzalną jakość i dostępność komponentów.",
  },
];
---

<B2BLayout
  title="Partnerzy"
  description="Współpracujący partnerzy BT Wood Studio — salony, producenci, architekci i dostawcy."
>
  <PageHero
    eyebrow="Sieć współpracy"
    title="Partnerzy"
    description="Budujemy długoterminowe relacje z firmami, które potrzebują rzetelnego zaplecza produkcyjnego i montażowego. Jeśli chcesz dołączyć do grona współpracujących partnerów — napisz do nas."
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        partnerTypes.map((partner) => (
          <article class="border border-stone-200 bg-white p-6">
            <h2 class="text-lg font-medium text-stone-900">{partner.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-stone-600">
              {partner.description}
            </p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 border border-stone-200 bg-stone-50 p-6 sm:p-8">
      <h2 class="text-xl font-medium text-stone-900">Zostań partnerem</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600">
        Oryginalna strona partnerska jest w rozbudowie. Tymczasem zapraszamy do
        bezpośredniego kontaktu w sprawie współpracy B2B:
        <a
          href="mailto:biuro@bt-woodstudio.com"
          class="font-medium text-stone-900 hover:underline"
        >
          biuro@bt-woodstudio.com
        </a>
      </p>
      <a
        href="/b2b/kontakt"
        class="mt-6 inline-flex bg-stone-900 px-5 py-3 text-[0.7rem] uppercase tracking-[0.14em] text-stone-50 hover:bg-stone-700"
      >
        Przejdź do kontaktu
      </a>
    </div>
  </section>
</B2BLayout>
