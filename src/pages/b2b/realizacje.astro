---
import B2BLayout from "../../layouts/b2b/Layout.astro";
import PageHero from "../../components/b2b/PageHero.astro";

const items = [
  {
    title: "Montaż kuchni kontraktowej",
    meta: "Montaż · Kraków",
    description:
      "Kompleksowy montaż zabudowy kuchennej z podłączeniem AGD i protokołem odbioru.",
    image:
      "https://images.unsplash.com/photo-1556912173-46c336c7fd55?auto=format&fit=crop&w=1200&q=80",
  },
  {
    title: "Seria elementów nesting CNC",
    meta: "Produkcja · B2B",
    description:
      "Rozkrój i oklejanie serii elementów meblowych na centrum nestingowym dla partnera handlowego.",
    image:
      "https://images.unsplash.com/photo-1504148455328-c376907d081c?auto=format&fit=crop&w=1200&q=80",
  },
  {
    title: "Zabudowa biurowa",
    meta: "Projekt + montaż",
    description:
      "Meble biurowe na wymiar: szafy, lady i zabudowy techniczne z pomiarem na obiekcie.",
    image:
      "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80",
  },
  {
    title: "Garderoby i szafy systemowe",
    meta: "Montaż · Niepołomice",
    description:
      "Montaż szaf i garderób, w tym przeróbki oraz realizacje poza standardem producenta.",
    image:
      "https://images.unsplash.com/photo-1558997519-83ea9252edf8?auto=format&fit=crop&w=1200&q=80",
  },
];
---

<B2BLayout
  title="Nasze realizacje"
  description="Wybrane realizacje produkcyjne i montażowe BT Wood Studio dla klientów B2B."
>
  <PageHero
    eyebrow="Portfolio"
    title="Nasze realizacje"
    description="Przegląd typowych zleceń — od nestingu i oklejania po montaż mebli i zabudów kontraktowych."
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        items.map((item) => (
          <article class="overflow-hidden border border-stone-200 bg-white">
            <div class="aspect-[16/10] overflow-hidden bg-stone-100">
              <img
                src={item.image}
                alt={item.title}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-5 sm:p-6">
              <p class="text-[0.62rem] uppercase tracking-[0.16em] text-stone-500">
                {item.meta}
              </p>
              <h2 class="mt-2 text-xl font-medium text-stone-900">
                {item.title}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-stone-600">
                {item.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-stone-600">
      Chcesz omówić podobne zlecenie?
      <a href="/b2b/kontakt" class="font-medium text-stone-900 hover:underline">
        biuro@bt-woodstudio.com
      </a>
    </p>
  </section>
</B2BLayout>
