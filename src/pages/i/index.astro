---
import Layout from "../../layouts/Layout.astro";
import Header from "../../layouts/Header.astro";
import Footer from "../../layouts/Footer.astro";
import Hero from "../../components/hero.astro";
import Portfolio from "../../components/portfolio.astro";
import Contact from "../../components/contact.astro";
import FAQ from "../../components/faq.astro";
import QuoteDivider from "../../components/Quote-divider.astro";
---

<Layout
  title="Stolarnia — meble na wymiar"
  description="Projektujemy i wykonujemy meble na wymiar — od kuchni, przez szafy, po indywidualne zabudowy."
>
  <Header />
  <main>
    <Hero />
    <Portfolio />
    <QuoteDivider
      text="Dom nie jest sumą pomieszczeń. Jest historią, którą opowiada się od wejścia."
    />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Layout>
